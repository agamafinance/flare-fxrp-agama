# Extension implementation language. This extension ships Python only.
LANGUAGE=python

# --- Chain ------------------------------------------------------------------

CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json

# Must be false on live networks.
LOCAL_MODE=false

# TEE attestation mode: true = test code hash / platform (no real TEE hardware).
# Set to false on a real GCP Confidential Space VM — FTDC rejects simulated
# attestation, so a testnet deploy needs SIMULATED_TEE=false and MODE=0 in the image.
SIMULATED_TEE=true

# --- Keys -------------------------------------------------------------------

# Funded Coston2 key: deploys the RFQ, opens it, and relays settlements.
# Faucet: https://faucet.flare.network/coston2
DEPLOYMENT_PRIVATE_KEY="<64 hex chars, no 0x prefix>"
INITIAL_OWNER="0x<address derived from DEPLOYMENT_PRIVATE_KEY>"

# Funded key the extension proxy signs with.
PROXY_PRIVATE_KEY="<64 hex chars, no 0x prefix>"

# TEE governance — the signer set and threshold that govern this extension's TEE
# machines. Leave unset for deployer-only (threshold 1).
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2

# --- The traded pair --------------------------------------------------------
# The RFQ escrows YT and pays the seller in FXRP; both are constructor arguments,
# so they must be set before pre-build.sh deploys the contract.
#
# Agama's live Coston2 confidential market:
#   FXRP (demo, public mint) 0xb23b0daDa02c86D2A7E76d2060c34Fff14D1E3A6
#   YT                       0x1592f5cd44676f182162AC9DC09F9B12C68E0B4D
FXRP_ADDR="0x<fxrp address>"
YT_ADDR="0x<yt address>"

# --- Proxies ----------------------------------------------------------------

# Flare's FTDC proxy for the target chain.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# This extension's proxy, publicly reachable (the VM's URL, or a tunnel to :6674).
EXT_PROXY_URL=https://<your-tunnel>.ngrok-free.dev

# Set if the proxy requires an API key on /direct (where sealed quotes arrive).
# DIRECT_API_KEY=
