# Confidential RFQ (the /rfq page): server-side keys for the real on-chain settlement.
# Copy to .env.local for local dev, or set as env vars on the deployment. Never commit real keys.
#
# The /rfq demo now settles over Flare Confidential Compute (extension 66302,
# AgamaRfqInstructionSender on GCP AMD SEV). The backend provisions what it needs
# per run (mints demo FXRP to the market makers, tops up their gas, splits YT for
# the demo seller), so only the relayer key must stay funded with C2FLR.
#
# ENCLAVE_URL and RFQ_ADDR default to the FCC deployment in code; set them only to
# override. Point ENCLAVE_URL at the extension proxy's public :6674, NOT the old
# Intel-TDX enclave on :8080.

DEMO_PRIVATE_KEY=0x<seller/relayer key, funded with C2FLR>
MM1_KEY=0x<market maker 1 (any key; the backend funds + approves it)>
MM2_KEY=0x<market maker 2 (any key; the backend funds + approves it)>
ENCLAVE_URL=http://136.113.147.228:6674
RFQ_ADDR=0x40d282d699698193eE7f0379039E1aa0ec7016b6
