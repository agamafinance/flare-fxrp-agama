# Confidential RFQ (the /rfq page): server-side keys for the real on-chain settlement.
# Copy to .env.local for local dev, or set as env vars on the deployment. Never commit real keys.
# The seller must hold YT (split FXRP via the splitter) and have approved YT -> RFQ; the two market
# makers must hold FXRP and have approved FXRP -> RFQ. See the setup steps in DEPLOY.md.

DEMO_PRIVATE_KEY=0x<seller/relayer key, funded with C2FLR + holding YT>
MM1_KEY=0x<market maker 1, funded with C2FLR + FXRP>
MM2_KEY=0x<market maker 2, funded with C2FLR + FXRP>
ENCLAVE_URL=http://34.59.74.87:8080
RFQ_ADDR=0x73F18087dd45d180e75cADcD383479624326E336
